# Copy to .dev.vars (never commit .dev.vars)

SESSION_SECRET=replace-with-a-long-random-string
APP_URL=http://localhost:5173
EMAIL_FROM=Cairn <hello@example.com>

DODO_PAYMENTS_ENVIRONMENT=test
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# Pro $29/mo
DODO_PRO_PRODUCT_ID=
DODO_MONTHLY_PRODUCT_ID=
# Business $79/mo
DODO_BUSINESS_PRODUCT_ID=

# Google OAuth (Web application). Callback: $APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App. Callback: $APP_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (customer-site checkout webhooks). Omit to disable /webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# Search Console uses the same Google client as login, but a separate OAuth flow.
# Add this redirect URI on the Google Cloud OAuth client:
#   $APP_URL/api/connect/gsc/callback
# Login remains $APP_URL/api/auth/google/callback
# Scope: https://www.googleapis.com/auth/webmasters.readonly plus openid email.

# Polar / Paddle / Lemon Squeezy (customer-site checkout webhooks). Omit a secret to disable that path (returns 500).
POLAR_WEBHOOK_SECRET=
PADDLE_WEBHOOK_SECRET=
LEMON_SQUEEZY_WEBHOOK_SECRET=
