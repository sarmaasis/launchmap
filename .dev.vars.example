# Copy to .dev.vars (never commit .dev.vars)

# HMAC secret for hashed magic-link and session tokens. openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Public origin used in magic-link URLs
APP_URL=http://localhost:5173

# From address for Cloudflare Email Service (verified sender domain)
EMAIL_FROM=Launchmap <hello@example.com>

# Dodo Payments https://app.dodopayments.com
# test | live  (also accepts test_mode | live_mode)
DODO_PAYMENTS_ENVIRONMENT=test
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# One-time $19 extra launch SKU
DODO_PRODUCT_ID=
# $9/mo unlimited. DODO_MONTHLY_PRODUCT_ID or DODO_PRICE
DODO_MONTHLY_PRODUCT_ID=
